ENV = 'production'

VITE_DEV_PORT = 5000
VITE_SERVER_API =/api/admin
VITE_SERVER_PATH = http://127.0.0.1:5000

# Used by the new webclient app (src/webclient) - hits the plain /api
# surface any enabled user can reach (POST /api/login, GET /api/peers,
# etc.), not the admin-only /api/admin one above.
VITE_WEBCLIENT_SERVER_API =/api

# Where Engine.vue loads the Flutter web engine (Phase 2) from. Matches
# the /webclient/engine/ route in rustdesk-api's router.go (Phase 6's
# cutover - /webclient/ now serves this Vue rebuild instead of the legacy
# bundle) - built and populated automatically by Rustdesk-Server-
# Installer's update.sh (build_flutter_engine). Keep in sync with that
# project's ENGINE_BASE_HREF default.
VITE_ENGINE_BASE_URL =/webclient/engine/
