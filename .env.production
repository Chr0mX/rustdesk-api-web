ENV = 'production'

VITE_DEV_PORT = 5000
VITE_SERVER_API =/api/admin
VITE_SERVER_PATH = http://127.0.0.1:5000

# Used by the new webclient app (src/webclient) - hits the plain /api
# surface any enabled user can reach (POST /api/login, GET /api/peers,
# etc.), not the admin-only /api/admin one above.
VITE_WEBCLIENT_SERVER_API =/api

# Where Engine.vue loads the Flutter web engine (Phase 2) from. Matches
# the /webclient-dev/engine/ preview route in rustdesk-api's router.go -
# not built/copied by update.sh yet (Phase 2's flutter build web is still
# a manual step), so this only resolves once someone has manually placed
# a build/web output there. Revisit at Phase 6's cutover, when this
# should point at wherever the real /webclient/ mount serves the engine
# from instead.
VITE_ENGINE_BASE_URL =/webclient-dev/engine/
